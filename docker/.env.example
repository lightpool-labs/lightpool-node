LP_RPC_PORT=26300
LP_WS_PORT=26400
LP_MEMPOOL_PORT=26000
CLOB_PORT=3002

# Root data directory (relative to docker/).
DATA_DIR=./data

# Docker build proxy (apt during --no-cache). Build uses network: host.
HTTP_PROXY=http://127.0.0.1:8118
HTTPS_PROXY=http://127.0.0.1:8118
NO_PROXY=localhost,127.0.0.1

# Validator private key (required). Treat like a database password.
# Local demo default — replace for anything beyond local use.
LIGHTPOOL_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
